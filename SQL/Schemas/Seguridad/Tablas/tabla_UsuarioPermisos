CREATE TABLE Seguridad.UsuarioPermisos
(
    UsuarioAplicacionId INT NOT NULL,
    PermisoId INT NOT NULL,

    CONSTRAINT PK_UsuarioPermisos
        PRIMARY KEY (UsuarioAplicacionId, PermisoId),

    CONSTRAINT FK_UsuarioPermisos_UsuarioAplicacion
        FOREIGN KEY (UsuarioAplicacionId)
        REFERENCES Seguridad.UsuarioAplicacion(UsuarioAplicacionId),

    CONSTRAINT FK_UsuarioPermisos_Permisos
        FOREIGN KEY (PermisoId)
        REFERENCES Seguridad.Permisos(PermisoId)
);