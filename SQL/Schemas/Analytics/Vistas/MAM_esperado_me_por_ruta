CREATE VIEW ANALYTICS.MAM_esperado_me_por_ruta
AS 
WITH clientes_activos_por_ruta AS (

    SELECT
        Ruta,
        COUNT(DISTINCT Codigo_GLN) AS clientes_activos

    FROM PowerStreet.UX

    WHERE Estatus = 'Activo'

    GROUP BY Ruta
),

vigencias_mensual AS (

    SELECT
        Familia,
        DATEFROMPARTS(
            YEAR(Inicio_Vigencia),
            MONTH(Inicio_Vigencia),
            1
        ) AS mes,

        DATEFROMPARTS(
            YEAR(ISNULL(Fin_Vigencia, GETDATE())),
            MONTH(ISNULL(Fin_Vigencia, GETDATE())),
            1
        ) AS mes_fin

    FROM CATALOGOS.Vigencias_ME

),